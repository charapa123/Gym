FROM
    "gym"."pres"."Answers_model" A
INNER JOIN
    "gym"."pres"."Questions_model" Q ON A.question_id = Q.questionid
GROUP BY
    A.insert_timestamp,
    A.response_id,
    A.create_time,
    A.respondent_email
  );
  
