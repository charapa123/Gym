  create view "gym"."staging"."Questions_model__dbt_tmp"
    
    
  as (
    SELECT
    -- raw_form_questions.id AS raw_id,
    item.value->>'itemId' AS itemId,
    CASE WHEN item.value->>'title' LIKE '%Exercises%' THEN 'Exercises' ELSE item.value->>'title' END AS TITLE,
